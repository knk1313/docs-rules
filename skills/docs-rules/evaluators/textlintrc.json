{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": { "max": 100 },
      "arabic-kanji-numbers": false,
      "max-kanji-continuous-len": { "max": 6, "allow": ["文化審議会建議", "出入国在留管理庁", "政府相互運用性", "科学技術振興機構", "電子情報通信学会", "国立国会図書館", "産業技術総合研究所"] },
      "no-mix-dearu-desumasu": { "preferInHeader": "", "preferInBody": "", "preferInList": "", "strict": false }
    },
    "preset-jtf-style": {
      "1.1.1.本文": false,
      "1.2.2.ピリオド(.)とカンマ(,)": false,
      "2.1.5.カタカナ": true,
      "2.2.2.算用数字と漢数字の使い分け": false,
      "3.1.1.全角文字と半角文字の間": false,
      "3.2.カタカナ語間のスペースの有無": false,
      "4.2.1.感嘆符(！)": false,
      "4.2.2.疑問符(？)": false,
      "4.2.9.ダッシュ(-)": false
    },
    "preset-ja-spacing": {
      "ja-space-after-exclamation": false,
      "ja-space-after-question": false
    },
    "prh": {
      "rulePaths": ["./prh/manual.yml", "./prh/okurigana.yml", "./prh/gairaigo.yml"]
    }
  }
}
