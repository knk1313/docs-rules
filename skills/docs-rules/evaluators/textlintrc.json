{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": false,
      "max-comma": false,
      "max-ten": false,
      "max-kanji-continuous-len": false,
      "no-mix-dearu-desumasu": false,
      "arabic-kanji-numbers": false,
      "no-doubled-conjunction": false,
      "ja-no-weak-phrase": false,
      "ja-no-successive-word": false,
      "ja-no-abusage": false,
      "ja-unnatural-alphabet": false,
      "no-unmatched-pair": false,
      "ja-no-redundant-expression": { "dictOptions": { "dict6": { "disabled": true } } }
    },
    "preset-jtf-style": {
      "1.1.1.本文": false,
      "1.1.3.箇条書き": false,
      "1.1.5.図表のキャプション": false,
      "1.2.2.ピリオド(.)とカンマ(,)": false,
      "2.1.2.漢字": false,
      "2.1.5.カタカナ": true,
      "2.1.6.カタカナの長音": false,
      "2.1.10.算用数字の位取りの表記": false,
      "2.2.1.ひらがなと漢字の使い分け": false,
      "2.2.2.算用数字と漢数字の使い分け": false,
      "2.2.3.一部の助数詞の表記": false,
      "3.1.1.全角文字と半角文字の間": false,
      "3.2.カタカナ語間のスペースの有無": false,
      "4.1.1.句点(。)": false,
      "4.1.3.ピリオド(.)、カンマ(,)": false,
      "4.2.1.感嘆符(！)": false,
      "4.2.2.疑問符(？)": false,
      "4.2.4.中黒(・)": false,
      "4.2.5.波線(〜)": false,
      "4.2.6.ハイフン(-)": false,
      "4.2.7.コロン(：)": false,
      "4.2.8.セミコロン(;)": false,
      "4.2.9.ダッシュ(-)": false,
      "4.3.1.丸かっこ（）": false,
      "4.3.2.大かっこ［］": false,
      "4.3.3.かぎかっこ「」": false,
      "4.3.4.二重かぎかっこ『』": false,
      "4.3.5.二重引用符": false,
      "4.3.6.中かっこ{ }": false,
      "4.3.7.山かっこ<>": false,
      "4.3.8.一重引用符": false
    },
    "preset-ja-spacing": {
      "ja-space-after-exclamation": false,
      "ja-space-after-question": false,
      "ja-space-around-code": false,
      "ja-space-around-link": false
    },
    "prh": {
      "rulePaths": ["./prh/manual.yml"]
    }
  }
}
