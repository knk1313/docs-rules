"rules": [
{"id": 1, "scope": "単独の語・活用のある語", "principle": {"text": "活用のある語（通則2を適用する語を除く。）は，活用語尾を送る。", "examples": [{"word": "憤る"}, {"word": "承る"}, {"word": "書く"}, {"word": "実る"}, {"word": "催す"}, {"word": "生きる"}, {"word": "陥れる"}, {"word": "考える"}, {"word": "助ける"}, {"word": "荒い"}, {"word": "潔い"}, {"word": "賢い"}, {"word": "濃い"}, {"word": "主だ"}]}, "exceptions": [{"text": "語幹が「し」で終わる形容詞は，「し」から送る。", "examples": [{"word": "著しい"}, {"word": "惜しい"}, {"word": "悔しい"}, {"word": "恋しい"}, {"word": "珍しい"}]}, {"text": "活用語尾の前に「か」，「やか」，「らか」を含む形容動詞は，その音節から送る。", "examples": [{"word": "暖かだ"}, {"word": "細かだ"}, {"word": "静かだ"}, {"word": "穏やかだ"}, {"word": "健やかだ"}, {"word": "和やかだ"}, {"word": "明らかだ"}, {"word": "平らかだ"}, {"word": "滑らかだ"}, {"word": "柔らかだ"}]}, {"text": "次の語は，次に示すように送る。", "examples": [{"word": "明らむ"}, {"word": "味わう"}, {"word": "哀れむ"}, {"word": "慈しむ"}, {"word": "教わる"}, {"word": "脅かす", "reading": "おどかす"}, {"word": "脅かす", "reading": "おびやかす"}, {"word": "関わる"}, {"word": "食らう"}, {"word": "異なる"}, {"word": "逆らう"}, {"word": "捕まる"}, {"word": "群がる"}, {"word": "和らぐ"}, {"word": "揺する"}, {"word": "明るい"}, {"word": "危ない"}, {"word": "危うい"}, {"word": "大きい"}, {"word": "少ない"}, {"word": "小さい"}, {"word": "冷たい"}, {"word": "平たい"}, {"word": "新ただ"}, {"word": "同じだ"}, {"word": "盛んだ"}, {"word": "平らだ"}, {"word": "懇ろだ"}, {"word": "惨めだ"}, {"word": "哀れだ"}, {"word": "幸いだ"}, {"word": "幸せだ"}, {"word": "巧みだ"}]}], "permitted": {"text": "次の語は，（　）の中に示すように，活用語尾の前の音節から送ることができる。", "pairs": [{"standard": "表す", "permitted": ["表わす"]}, {"standard": "著す", "permitted": ["著わす"]}, {"standard": "現れる", "permitted": ["現われる"]}, {"standard": "行う", "permitted": ["行なう"]}, {"standard": "断る", "permitted": ["断わる"]}, {"standard": "賜る", "permitted": ["賜わる"]}]}, "notes": ["語幹と活用語尾との区別がつかない動詞は，例えば，「着る」，「寝る」，「来る」などのように送る。"]},
{"id": 2, "scope": "単独の語・活用のある語", "principle": {"text": "活用語尾以外の部分に他の語を含む語は，含まれている語の送り仮名の付け方によって送る。（含まれている語を〔　〕の中に示す。）", "groups": [{"label": "動詞の活用形又はそれに準ずるものを含むもの。", "examples": [{"word": "動かす", "base": "動く"}, {"word": "照らす", "base": "照る"}, {"word": "語らう", "base": "語る"}, {"word": "計らう", "base": "計る"}, {"word": "向かう", "base": "向く"}, {"word": "浮かぶ", "base": "浮く"}, {"word": "生まれる", "base": "生む"}, {"word": "押さえる", "base": "押す"}, {"word": "捕らえる", "base": "捕る"}, {"word": "勇ましい", "base": "勇む"}, {"word": "輝かしい", "base": "輝く"}, {"word": "喜ばしい", "base": "喜ぶ"}, {"word": "晴れやかだ", "base": "晴れる"}, {"word": "及ぼす", "base": "及ぶ"}, {"word": "積もる", "base": "積む"}, {"word": "聞こえる", "base": "聞く"}, {"word": "頼もしい", "base": "頼む"}, {"word": "起こる", "base": "起きる"}, {"word": "落とす", "base": "落ちる"}, {"word": "暮らす", "base": "暮れる"}, {"word": "冷やす", "base": "冷える"}, {"word": "当たる", "base": "当てる"}, {"word": "終わる", "base": "終える"}, {"word": "変わる", "base": "変える"}, {"word": "集まる", "base": "集める"}, {"word": "定まる", "base": "定める"}, {"word": "連なる", "base": "連ねる"}, {"word": "交わる", "base": "交える"}, {"word": "混ざる", "base": "混ぜる"}, {"word": "混じる", "base": "混ぜる"}, {"word": "恐ろしい", "base": "恐れる"}]}, {"label": "形容詞・形容動詞の語幹を含むもの。", "examples": [{"word": "重んずる", "base": "重い"}, {"word": "若やぐ", "base": "若い"}, {"word": "怪しむ", "base": "怪しい"}, {"word": "悲しむ", "base": "悲しい"}, {"word": "苦しがる", "base": "苦しい"}, {"word": "確かめる", "base": "確かだ"}, {"word": "重たい", "base": "重い"}, {"word": "憎らしい", "base": "憎い"}, {"word": "古めかしい", "base": "古い"}, {"word": "細かい", "base": "細かだ"}, {"word": "柔らかい", "base": "柔らかだ"}, {"word": "清らかだ", "base": "清い"}, {"word": "高らかだ", "base": "高い"}, {"word": "寂しげだ", "base": "寂しい"}]}, {"label": "名詞を含むもの。", "examples": [{"word": "汗ばむ", "base": "汗"}, {"word": "先んずる", "base": "先"}, {"word": "春めく", "base": "春"}, {"word": "男らしい", "base": "男"}, {"word": "後ろめたい", "base": "後ろ"}]}]}, "exceptions": [], "permitted": {"text": "読み間違えるおそれのない場合は，活用語尾以外の部分について，次の（　）の中に示すように，送り仮名を省くことができる。", "pairs": [{"standard": "浮かぶ", "permitted": ["浮ぶ"]}, {"standard": "生まれる", "permitted": ["生れる"]}, {"standard": "押さえる", "permitted": ["押える"]}, {"standard": "捕らえる", "permitted": ["捕える"]}, {"standard": "晴れやかだ", "permitted": ["晴やかだ"]}, {"standard": "積もる", "permitted": ["積る"]}, {"standard": "聞こえる", "permitted": ["聞える"]}, {"standard": "起こる", "permitted": ["起る"]}, {"standard": "落とす", "permitted": ["落す"]}, {"standard": "暮らす", "permitted": ["暮す"]}, {"standard": "当たる", "permitted": ["当る"]}, {"standard": "終わる", "permitted": ["終る"]}, {"standard": "変わる", "permitted": ["変る"]}]}, "notes": ["次の語は，それぞれ〔　〕の中に示す語を含むものとは考えず，通則1によるものとする。 明るい〔明ける〕 荒い〔荒れる〕 悔しい〔悔いる〕 恋しい〔恋う〕"]},
{"id": 3, "scope": "単独の語・活用のない語", "principle": {"text": "名詞（通則4を適用する語を除く。）は，送り仮名を付けない。", "examples": [{"word": "月"}, {"word": "鳥"}, {"word": "花"}, {"word": "山"}, {"word": "男"}, {"word": "女"}, {"word": "彼"}, {"word": "何"}]}, "exceptions": [{"text": "次の語は，最後の音節を送る。", "examples": [{"word": "辺り"}, {"word": "哀れ"}, {"word": "勢い"}, {"word": "幾ら"}, {"word": "後ろ"}, {"word": "傍ら"}, {"word": "幸い"}, {"word": "幸せ"}, {"word": "全て"}, {"word": "互い"}, {"word": "便り"}, {"word": "半ば"}, {"word": "情け"}, {"word": "斜め"}, {"word": "独り"}, {"word": "誉れ"}, {"word": "自ら"}, {"word": "災い"}]}, {"text": "数をかぞえる「つ」を含む名詞は，その「つ」を送る。", "examples": [{"word": "一つ"}, {"word": "二つ"}, {"word": "三つ"}, {"word": "幾つ"}]}], "permitted": null, "notes": []},
{"id": 4, "scope": "単独の語・活用のない語", "principle": {"text": "活用のある語から転じた名詞及び活用のある語に「さ」，「み」，「げ」などの接尾語が付いて名詞になったものは，もとの語の送り仮名の付け方によって送る。", "groups": [{"label": "活用のある語から転じたもの。", "examples": [{"word": "動き"}, {"word": "仰せ"}, {"word": "恐れ"}, {"word": "薫り"}, {"word": "曇り"}, {"word": "調べ"}, {"word": "届け"}, {"word": "願い"}, {"word": "晴れ"}, {"word": "当たり"}, {"word": "代わり"}, {"word": "向かい"}, {"word": "狩り"}, {"word": "答え"}, {"word": "問い"}, {"word": "祭り"}, {"word": "群れ"}, {"word": "憩い"}, {"word": "愁い"}, {"word": "憂い"}, {"word": "香り"}, {"word": "極み"}, {"word": "初め"}, {"word": "近く"}, {"word": "遠く"}]}, {"label": "「さ」，「み」，「げ」などの接尾語が付いたもの。", "examples": [{"word": "暑さ"}, {"word": "大きさ"}, {"word": "正しさ"}, {"word": "確かさ"}, {"word": "明るみ"}, {"word": "重み"}, {"word": "憎しみ"}, {"word": "惜しげ"}]}]}, "exceptions": [{"text": "次の語は，送り仮名を付けない。", "examples": [{"word": "謡"}, {"word": "虞"}, {"word": "趣"}, {"word": "氷"}, {"word": "印"}, {"word": "頂"}, {"word": "帯"}, {"word": "畳"}, {"word": "卸"}, {"word": "煙"}, {"word": "恋"}, {"word": "志"}, {"word": "次"}, {"word": "隣"}, {"word": "富"}, {"word": "恥"}, {"word": "話"}, {"word": "光"}, {"word": "舞"}, {"word": "折"}, {"word": "係"}, {"word": "掛", "reading": "かかり"}, {"word": "組"}, {"word": "肥"}, {"word": "並", "reading": "なみ"}, {"word": "巻"}, {"word": "割"}]}], "permitted": {"text": "読み間違えるおそれのない場合は，次の（　）の中に示すように，送り仮名を省くことができる。", "pairs": [{"standard": "曇り", "permitted": ["曇"]}, {"standard": "届け", "permitted": ["届"]}, {"standard": "願い", "permitted": ["願"]}, {"standard": "晴れ", "permitted": ["晴"]}, {"standard": "当たり", "permitted": ["当り"]}, {"standard": "代わり", "permitted": ["代り"]}, {"standard": "向かい", "permitted": ["向い"]}, {"standard": "狩り", "permitted": ["狩"]}, {"standard": "答え", "permitted": ["答"]}, {"standard": "問い", "permitted": ["問"]}, {"standard": "祭り", "permitted": ["祭"]}, {"standard": "群れ", "permitted": ["群"]}, {"standard": "憩い", "permitted": ["憩"]}]}, "notes": ["ここに掲げた「組」は，「花の組」，「赤の組」などのように使った場合の「くみ」であり，例えば，「活字の組みがゆるむ。」などとして使う場合の「くみ」を意味するものではない。「光」，「折」，「係」なども，同様に動詞の意識が残っているような使い方の場合は，この例外に該当しない。したがって，本則を適用して送り仮名を付ける。"]},
{"id": 5, "scope": "単独の語・活用のない語", "principle": {"text": "副詞・連体詞・接続詞は，最後の音節を送る。", "examples": [{"word": "必ず"}, {"word": "更に"}, {"word": "少し"}, {"word": "既に"}, {"word": "再び"}, {"word": "全く"}, {"word": "最も"}, {"word": "来る"}, {"word": "去る"}, {"word": "及び"}, {"word": "且つ"}, {"word": "但し"}]}, "exceptions": [{"text": "次の語は，次に示すように送る。", "examples": [{"word": "明くる"}, {"word": "大いに"}, {"word": "直ちに"}, {"word": "並びに"}, {"word": "若しくは"}]}, {"text": "次の語は，送り仮名を付けない。", "examples": [{"word": "又"}]}, {"text": "次のように，他の語を含む語は，含まれている語の送り仮名の付け方によって送る。（含まれている語を〔　〕の中に示す。）", "examples": [{"word": "併せて", "base": "併せる"}, {"word": "至って", "base": "至る"}, {"word": "恐らく", "base": "恐れる"}, {"word": "従って", "base": "従う"}, {"word": "絶えず", "base": "絶える"}, {"word": "例えば", "base": "例える"}, {"word": "努めて", "base": "努める"}, {"word": "辛うじて", "base": "辛い"}, {"word": "少なくとも", "base": "少ない"}, {"word": "互いに", "base": "互い"}, {"word": "必ずしも", "base": "必ず"}]}], "permitted": null, "notes": []},
{"id": 6, "scope": "複合の語", "principle": {"text": "複合の語（通則7を適用する語を除く。）の送り仮名は，その複合の語を書き表す漢字の，それぞれの音訓を用いた単独の語の送り仮名の付け方による。", "groups": [{"label": "活用のある語", "examples": [{"word": "書き抜く"}, {"word": "流れ込む"}, {"word": "申し込む"}, {"word": "打ち合わせる"}, {"word": "向かい合わせる"}, {"word": "長引く"}, {"word": "若返る"}, {"word": "裏切る"}, {"word": "旅立つ"}, {"word": "聞き苦しい"}, {"word": "薄暗い"}, {"word": "草深い"}, {"word": "心細い"}, {"word": "待ち遠しい"}, {"word": "軽々しい"}, {"word": "若々しい"}, {"word": "女々しい"}, {"word": "気軽だ"}, {"word": "望み薄だ"}]}, {"label": "活用のない語", "examples": [{"word": "石橋"}, {"word": "竹馬"}, {"word": "山津波"}, {"word": "後ろ姿"}, {"word": "斜め左"}, {"word": "花便り"}, {"word": "独り言"}, {"word": "卸商"}, {"word": "水煙"}, {"word": "目印"}, {"word": "田植え"}, {"word": "封切り"}, {"word": "物知り"}, {"word": "落書き"}, {"word": "雨上がり"}, {"word": "墓参り"}, {"word": "日当たり"}, {"word": "夜明かし"}, {"word": "先駆け"}, {"word": "巣立ち"}, {"word": "手渡し"}, {"word": "入り江"}, {"word": "飛び火"}, {"word": "教え子"}, {"word": "合わせ鏡"}, {"word": "生き物"}, {"word": "落ち葉"}, {"word": "預かり金"}, {"word": "寒空"}, {"word": "深情け"}, {"word": "愚か者"}, {"word": "行き帰り"}, {"word": "伸び縮み"}, {"word": "乗り降り"}, {"word": "抜け駆け"}, {"word": "作り笑い"}, {"word": "暮らし向き"}, {"word": "売り上げ"}, {"word": "取り扱い"}, {"word": "乗り換え"}, {"word": "引き換え"}, {"word": "歩み寄り"}, {"word": "申し込み"}, {"word": "移り変わり"}, {"word": "長生き"}, {"word": "早起き"}, {"word": "苦し紛れ"}, {"word": "大写し"}, {"word": "粘り強さ"}, {"word": "有り難み"}, {"word": "待ち遠しさ"}, {"word": "乳飲み子"}, {"word": "無理強い"}, {"word": "立ち居振る舞い"}, {"word": "呼び出し電話"}, {"word": "次々"}, {"word": "常々"}, {"word": "近々"}, {"word": "深々"}, {"word": "休み休み"}, {"word": "行く行く"}]}]}, "exceptions": [], "permitted": {"text": "読み間違えるおそれのない場合は，次の（　）の中に示すように，送り仮名を省くことができる。", "pairs": [{"standard": "書き抜く", "permitted": ["書抜く"]}, {"standard": "申し込む", "permitted": ["申込む"]}, {"standard": "打ち合わせる", "permitted": ["打ち合せる", "打合せる"]}, {"standard": "向かい合わせる", "permitted": ["向い合せる"]}, {"standard": "聞き苦しい", "permitted": ["聞苦しい"]}, {"standard": "待ち遠しい", "permitted": ["待遠しい"]}, {"standa